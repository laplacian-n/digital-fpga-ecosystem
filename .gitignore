ai/tools/
# third-party VHDL dataset (re-downloadable)
ai/datasets/
# generated .vhd/.xdc/.bit/.tcl
ai/out/

# RAG index — rebuild with ai/rag/build_index.py + embed_index.py
ai/rag/index.jsonl
ai/rag/emb.npz

# Course material & graded lab work (copyrighted / personal) — local only
/content/
/labAssignment/
/mywork/

